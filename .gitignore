# Runtime / environment — copy config-example.php to config.php and edit
# it with real credentials; config.php itself is never tracked, so a
# `git pull` on the server never overwrites live credentials.
config.php
config.local.php
*.env

# Logs generated by the DB Tools ad-hoc SQL runner
/sql/schema_log.txt

# Admin management key (DB Tools "Admin Account" section) — server secret
/sql/key.txt

# Dependencies (none currently, reserved for future)
/vendor/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
