# Block direct HTTP access to plain-text files in this folder
# (schema_log.txt, key.txt) — PHP scripts here can still read them
# server-side via file_get_contents(); this only blocks browser requests.
<FilesMatch "\.txt$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
